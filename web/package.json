{
  "name": "casefile-earth-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "CaseFile Earth: the static site. It reads result files and computes nothing.",
  "license": "MIT",
  "scripts": {
    "strings": "node scripts/compile-strings.mjs",
    "predev": "npm run strings",
    "dev": "vite",
    "prebuild": "npm run strings",
    "build": "vite build",
    "prebuild:offline": "npm run strings",
    "build:offline": "vite build --config vite.offline.config.ts",
    "preview": "vite preview",
    "pretypecheck": "npm run strings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "pretest": "npm run strings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @screens",
    "screens": "playwright test --project=screens --grep @screens"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@fontsource/noto-sans-bengali": "5.3.0",
    "@fontsource/noto-serif-bengali": "5.3.0",
    "@observablehq/plot": "0.6.19",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3-scale-chromatic": "3.1.1",
    "fflate": "0.8.3",
    "globe.gl": "2.45.3",
    "lucide-react": "1.72.0",
    "motion": "14.13.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/d3-scale-chromatic": "3.1.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/topojson-client": "3.1.5",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "tailwindcss": "4.3.5",
    "topojson-client": "3.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0",
    "world-atlas": "2.0.2"
  }
}
