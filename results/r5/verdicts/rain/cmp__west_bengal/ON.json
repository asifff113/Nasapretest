 "text": {
  "en": {
   "headline": "Rain and snowfall in West Bengal (Oct–Nov total) rose by 92 mm over 1980–2025.",
   "howMuch": [
    "Rate: +21 mm per decade (95% range +5 mm to +35 mm).",
    "Total change over 1980–2025: +92 mm (+168% of the starting level).",
    "That is about as big as the usual year-to-year ups and downs."
   ],
   "howSure": [
    "A secondary result: one of 48 season tests registered in advance; after correcting for them, p = 0.023.",
    "Mann–Kendall test allowing for year-to-year memory, before correction: p = 0.005.",
    "That is below the 0.05 line we set in advance."
   ],
   "checks": [
    "No missing years.",
    "No documented data change falls inside these years.",
    "No single year decides the answer.",
    "Only 3 of 5 other windows agree: the answer depends on the years chosen."
   ],
   "practical": [
    "We decided in advance that a change of 40 mm per decade matters. The whole 95% range is smaller than that."
   ],
   "overturn": [
    "The answer leans most on 1981: without it, p = 0.014.",
    "The weakest of the other windows, 1980–2019, gives +16 mm per decade.",
    "IMERG, a different rain record, points the other way over 1998–2024."
   ],
   "notes": [
    "Secondary result (seasons).",
    "This comes from a model that blends many observations (a reanalysis). Models can shift when the observations they use change."
   ]
