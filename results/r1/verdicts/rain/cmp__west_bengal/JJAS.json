  "en": {
   "headline": "Rain and snowfall in West Bengal (Jun–Sep total) rose by 492 mm over 1980–2025.",
   "howMuch": [
    "Rate: +109 mm per decade (95% range +57 mm to +163 mm).",
    "Total change over 1980–2025: +492 mm (+63% of the starting level).",
    "That is bigger than the usual year-to-year ups and downs."
   ],
   "howSure": [
    "A secondary result: one of 48 season tests registered in advance; after correcting for them, p = 0.002.",
    "Mann–Kendall test allowing for year-to-year memory, before correction: p < 0.001.",
    "That is below the 0.05 line we set in advance."
   ],
   "checks": [
    "No missing years.",
    "No documented data change falls inside these years.",
    "No single year decides the answer.",
    "5 of 5 other windows agree."
   ],
   "practical": [
    "We decided in advance that a change of 40 mm per decade matters. The whole 95% range is beyond that."
   ],
   "overturn": [
    "The answer leans most on 1983: without it, p < 0.001.",
    "The weakest of the other windows, 1980–2019, gives +97 mm per decade.",
    "IMERG, a different rain record, points the other way over 1998–2024."
   ],
   "notes": [
    "Secondary result (seasons).",
    "This comes from a model that blends many observations (a reanalysis). Models can shift when the observations they use change."
   ]
