{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile-earth.github.io/spec/schemas/input_manifest.schema.json",
  "title": "Pinned input manifest — every input file by SHA-256 (02_DATA §9)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "casefile/input_manifest@3"
    },
    "manifestId": {
      "type": "string"
    },
    "created": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "shortName": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "query": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "temporal": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "bbox": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "number"
                },
                "minItems": 4,
                "maxItems": 4
              }
            },
            "additionalProperties": false,
            "required": [
              "provider",
              "temporal",
              "bbox"
            ]
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "units": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "fill": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "firstMonth": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "lastMonth": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
          },
          "granuleCount": {
            "type": "integer"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "month": {
                  "type": "string"
                },
                "sha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                },
                "bytes": {
                  "type": "integer"
                },
                "valuesSha256": {
                  "$ref": "common.schema.json#/$defs/sha256"
                }
              },
              "additionalProperties": false,
              "required": [
                "name",
                "month",
                "sha256",
                "bytes"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "source",
          "shortName",
          "version",
          "doi",
          "query",
          "variables",
          "units",
          "fill",
          "firstMonth",
          "lastMonth",
          "granuleCount",
          "files"
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "skip"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "result",
          "note"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "manifestId",
    "created",
    "synthetic",
    "products",
    "checks"
  ]
}
