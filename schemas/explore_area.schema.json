{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile-earth.github.io/spec/schemas/explore_area.schema.json",
  "title": "Area detail — the world, the world's land or a continent: the same blocks as a region detail file (exploration)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "casefile/explore_area@3"
    },
    "buildId": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "label": {
      "const": "exploration"
    },
    "grid": {
      "type": "string"
    },
    "area": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(world|world:land|continent:[a-z_]+)$"
        },
        "kind": {
          "enum": [
            "world",
            "continent"
          ]
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text2"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "centroid": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "areaKm2": {
          "type": "number",
          "minimum": 0
        },
        "effectiveCells": {
          "type": "number",
          "minimum": 0
        },
        "spillShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "passesSupport": {
          "type": "boolean"
        },
        "iso3": {
          "type": [
            "string",
            "null"
          ]
        },
        "continent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "bbox",
        "centroid",
        "areaKm2",
        "effectiveCells",
        "spillShare",
        "passesSupport",
        "iso3",
        "continent"
      ]
    },
    "boundary": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "licence"
      ]
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unitsMonthly": {
            "type": "string"
          },
          "units": {
            "type": "string"
          },
          "rule": {
            "enum": [
              "mean",
              "sum"
            ]
          },
          "years": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "annual": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "monthlyClimatology": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 12,
            "maxItems": 12
          },
          "baseline": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "array",
                "items": {
                  "type": "integer"
                },
                "minItems": 2,
                "maxItems": 2
              }
            ]
          },
          "annualAnomaly": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "monthlyAnomaly": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "minItems": 12,
              "maxItems": 12
            }
          },
          "rolling10": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "decades": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "properties": {
                  "early": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "integer"
                      },
                      "to": {
                        "type": "integer"
                      },
                      "mean": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "monthly": {
                        "type": "array",
                        "items": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "minItems": 12,
                        "maxItems": 12
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "from",
                      "to",
                      "mean",
                      "monthly"
                    ]
                  },
                  "late": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "integer"
                      },
                      "to": {
                        "type": "integer"
                      },
                      "mean": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "monthly": {
                        "type": "array",
                        "items": {
                          "type": [
                            "number",
                            "null"
                          ]
                        },
                        "minItems": 12,
                        "maxItems": 12
                      }
                    },
                    "additionalProperties": false,
                    "required": [
                      "from",
                      "to",
                      "mean",
                      "monthly"
                    ]
                  },
                  "change": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "changeMonthly": {
                    "type": "array",
                    "items": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "minItems": 12,
                    "maxItems": 12
                  }
                },
                "additionalProperties": false,
                "required": [
                  "early",
                  "late",
                  "change",
                  "changeMonthly"
                ]
              }
            ]
          },
          "trend": {
            "type": "object",
            "properties": {
              "testable": {
                "type": "boolean"
              },
              "reason": {
                "enum": [
                  null,
                  "ok",
                  "descriptive",
                  "too_short",
                  "missing_year",
                  "constant",
                  "not_finite",
                  "phi_out_of_range"
                ]
              },
              "exploratory": {
                "type": "boolean"
              },
              "n": {
                "type": "integer"
              },
              "first": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "last": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "ratePerDecade": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "lowPerDecade": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "highPerDecade": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "p": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "q": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "standsOut": {
                "type": "boolean"
              },
              "phi": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "jumpYear": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            },
            "additionalProperties": false,
            "required": [
              "testable",
              "reason",
              "exploratory",
              "n",
              "first",
              "last",
              "ratePerDecade",
              "lowPerDecade",
              "highPerDecade",
              "p",
              "q",
              "standsOut",
              "phi",
              "jumpYear"
            ]
          },
          "monthTrends": {
            "type": "array",
            "minItems": 12,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "testable": {
                  "type": "boolean"
                },
                "reason": {
                  "enum": [
                    null,
                    "ok",
                    "descriptive",
                    "too_short",
                    "missing_year",
                    "constant",
                    "not_finite",
                    "phi_out_of_range"
                  ]
                },
                "ratePerDecade": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "p": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "q": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "standsOut": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false,
              "required": [
                "testable",
                "reason",
                "ratePerDecade",
                "p",
                "q",
                "standsOut"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "unitsMonthly",
          "units",
          "rule",
          "years",
          "annual",
          "monthlyClimatology",
          "baseline",
          "annualAnomaly",
          "monthlyAnomaly",
          "rolling10",
          "decades",
          "trend",
          "monthTrends"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "buildId",
    "synthetic",
    "label",
    "grid",
    "area",
    "boundary",
    "variables"
  ]
}
