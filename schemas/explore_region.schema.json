{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://casefile-earth.github.io/spec/schemas/explore_region.schema.json",
  "title": "Region detail — yearly values and monthly climatology of one region for every parameter (exploration)",
  "type": "object",
  "properties": {
    "schema": {
      "const": "casefile/explore_region@3"
    },
    "buildId": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "label": {
      "const": "exploration"
    },
    "grid": {
      "type": "string"
    },
    "region": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/regionId"
        },
        "kind": {
          "enum": [
            "country",
            "division",
            "comparison"
          ]
        },
        "name": {
          "$ref": "common.schema.json#/$defs/text2"
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "centroid": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "areaKm2": {
          "type": "number",
          "minimum": 0
        },
        "effectiveCells": {
          "type": "number",
          "minimum": 0
        },
        "spillShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "passesSupport": {
          "type": "boolean"
        },
        "iso3": {
          "type": [
            "string",
            "null"
          ]
        },
        "continent": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "bbox",
        "centroid",
        "areaKm2",
        "effectiveCells",
        "spillShare",
        "passesSupport",
        "iso3",
        "continent"
      ]
    },
    "boundary": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "licence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "licence"
      ]
    },
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unitsMonthly": {
            "type": "string"
          },
          "units": {
            "type": "string"
          },
          "rule": {
            "enum": [
              "mean",
              "sum"
            ]
          },
          "years": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "annual": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            }
          },
          "monthlyClimatology": {
            "type": "array",
            "items": {
              "type": [
                "number",
                "null"
              ]
            },
            "minItems": 12,
            "maxItems": 12
          }
        },
        "additionalProperties": false,
        "required": [
          "unitsMonthly",
          "units",
          "rule",
          "years",
          "annual",
          "monthlyClimatology"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "buildId",
    "synthetic",
    "label",
    "grid",
    "region",
    "boundary",
    "variables"
  ]
}
