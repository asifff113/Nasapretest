 "text": {
  "en": {
   "headline": "Sensitivity check: +90 mm per decade (95% range −47 mm to +255 mm) in IMERG, a second rain record. It is shown beside MERRA-2 and gets no verdict.",
   "howMuch": [
    "Rate: +90 mm per decade (95% range −47 mm to +255 mm).",
    "Total change over 1998–2024: +233 mm (+9.8% of the starting level).",
    "That is about as big as the usual year-to-year ups and downs."
   ],
   "howSure": [],
