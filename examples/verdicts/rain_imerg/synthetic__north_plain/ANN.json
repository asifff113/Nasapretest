 "text": {
  "en": {
   "headline": "Sensitivity check: −102 mm per decade (95% range −230 mm to +26 mm) in IMERG, a second rain record. It is shown beside MERRA-2 and gets no verdict.",
   "howMuch": [
    "Rate: −102 mm per decade (95% range −230 mm to +26 mm).",
    "Total change over 1998–2024: −264 mm (−12% of the starting level).",
    "That is about as big as the usual year-to-year ups and downs."
   ],
   "howSure": [],
   "checks": [
    "No missing years.",
    "A documented data change falls in 2014 (IMERG moved from the TRMM era to the GPM era (June 2014)) and has not been checked by a person yet.",
