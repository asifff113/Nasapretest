 "text": {
  "en": {
   "headline": "Air temperature near the ground changed at different rates in North Plain (example) and South Delta (example): the trend in the difference (North Plain (example) − South Delta (example)) is +0.054 °C per decade (95% range +0.005 °C to +0.103 °C).",
   "howMuch": [
    "North Plain (example): +0.29 °C per decade (95% range +0.24 °C to +0.36 °C). South Delta (example): +0.24 °C per decade (95% range +0.16 °C to +0.31 °C).",
    "Each place's own rate is shown beside the difference, never subtracted from it."
   ],
   "howSure": [
    "One of 6 tests we registered in advance; after correcting for all of them, p = 0.026.",
    "Mann–Kendall test allowing for year-to-year memory, before correction: p = 0.013.",
